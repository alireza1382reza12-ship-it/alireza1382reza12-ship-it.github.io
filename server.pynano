import os
import json
import mimetypes
from urllib.parse import quote, unquote
from http.server import ThreadingHTTPServer, BaseHTTPRequestHandler

BASE = os.path.expanduser("~/music-site")
PORT = 8080


HTML = r'''<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#09070f">
<title>NAVA 🎵</title>

<style>
*{box-sizing:border-box}

html,body{
    margin:0;
    padding:0;
    background:#08070d;
    color:#fff;
    font-family:Tahoma,Arial,sans-serif;
}

body{
    min-height:100vh;
    padding-bottom:110px;
}

header{
    padding:28px 22px 22px;
    background:
      radial-gradient(circle at 90% 0%,#7c20ff55,transparent 35%),
      radial-gradient(circle at 10% 20%,#bd32ff33,transparent 30%),
      #0b0911;
}

.brand{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:10px;
    margin-bottom:20px;
}

.brand .note{
    font-size:42px;
}

.brand h1{
    margin:0;
    font-size:42px;
    letter-spacing:2px;
    color:#b85cff;
}

.tagline{
    text-align:center;
    color:#aaa;
    font-size:18px;
    margin-bottom:25px;
}

.search{
    max-width:650px;
    margin:auto;
    position:relative;
}

.search input{
    width:100%;
    border:1px solid #302a3d;
    outline:none;
    border-radius:28px;
    background:#17141e;
    color:#fff;
    padding:18px 52px 18px 20px;
    font-size:17px;
}

.search span{
    position:absolute;
    right:18px;
    top:13px;
    font-size:25px;
}

.categories{
    display:flex;
    gap:10px;
    overflow-x:auto;
    padding:20px 15px 5px;
    scrollbar-width:none;
}

.categories::-webkit-scrollbar{display:none}

.cat{
    flex:none;
    padding:13px 25px;
    border-radius:30px;
    border:1px solid #302a3d;
    background:#17151d;
    color:#aaa;
    font-size:15px;
}

.cat.active{
    background:#9a35ff;
    color:white;
    border-color:#9a35ff;
}

.hero{
    margin:28px 18px;
    border-radius:32px;
    padding:45px 25px;
    min-height:230px;
    display:flex;
    flex-direction:column;
    justify-content:center;
    background:
      radial-gradient(circle at 25% 30%,#d73cffaa,transparent 35%),
      radial-gradient(circle at 80% 80%,#5524e8aa,transparent 40%),
      #171022;
    border:1px solid #30213d;
}

.hero h2{
    margin:0 0 18px;
    font-size:30px;
}

.hero p{
    margin:0;
    color:#bbb;
    font-size:17px;
}

.section-title{
    padding:0 25px;
    margin-top:32px;
    font-size:26px;
}

#songs{
    padding:10px 18px 150px;
}

.song{
    display:flex;
    align-items:center;
    gap:14px;
    padding:15px;
    margin:12px 0;
    border:1px solid #292532;
    border-radius:24px;
    background:#121017;
    transition:.2s;
}

.song:hover{
    border-color:#8736d7;
    transform:translateY(-1px);
}

.cover{
    width:72px;
    height:72px;
    flex:none;
    border-radius:20px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:34px;
    background:linear-gradient(135deg,#a42cff,#6d1cff);
}

.songinfo{
    min-width:0;
    flex:1;
}

.songname{
    font-size:16px;
    font-weight:bold;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
}

.songtype{
    margin-top:9px;
    color:#888;
    font-size:13px;
}

.play{
    width:54px;
    height:54px;
    border:0;
    border-radius:50%;
    background:#a238ff;
    color:#fff;
    font-size:23px;
    flex:none;
}

.fav{
    width:40px;
    height:40px;
    border:0;
    background:transparent;
    color:#777;
    font-size:24px;
}

.fav.on{
    color:#ff4fba;
}

.empty{
    text-align:center;
    color:#888;
    padding:50px 20px;
}

.player{
    position:fixed;
    z-index:20;
    left:0;
    right:0;
    bottom:0;
    background:#111016ee;
    backdrop-filter:blur(18px);
    border-top:1px solid #302a38;
    padding:12px 16px calc(12px + env(safe-area-inset-bottom));
}

.player-top{
    display:flex;
    align-items:center;
    gap:12px;
    max-width:900px;
    margin:auto;
}

.now-cover{
    width:48px;
    height:48px;
    border-radius:15px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:linear-gradient(135deg,#a42cff,#6d1cff);
    font-size:22px;
}

.now-info{
    flex:1;
    min-width:0;
}

.now-name{
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
    font-size:14px;
}

.controls{
    display:flex;
    align-items:center;
    gap:7px;
}

.ctrl{
    border:0;
    background:#24202b;
    color:#fff;
    border-radius:50%;
    width:42px;
    height:42px;
    font-size:17px;
}

.ctrl.main{
    background:#a238ff;
    width:50px;
    height:50px;
}

.progress{
    width:100%;
    max-width:900px;
    margin:9px auto 0;
    display:block;
    accent-color:#a238ff;
}

.time{
    display:flex;
    justify-content:space-between;
    max-width:900px;
    margin:3px auto 0;
    color:#777;
    font-size:11px;
    direction:ltr;
}

.no-songs{
    text-align:center;
    color:#aaa;
    padding:45px 20px;
}

@media(max-width:500px){
    .brand h1{font-size:36px}
    .hero h2{font-size:26px}
    .section-title{font-size:23px}
    .song{padding:12px}
    .cover{width:62px;height:62px}
    .controls .secondary{display:none}
}
</style>
</head>

<body>

<header>
    <div class="brand">
        <span class="note">♪</span>
        <h1>NAVA</h1>
    </div>

    <div class="tagline">موسیقی رو زندگی کن</div>

    <div class="search">
        <span>🔎</span>
        <input id="search" type="search" placeholder="جستجوی آهنگ یا خواننده...">
    </div>
</header>

<div class="categories">
    <button class="cat active" data-filter="all">همه</button>
    <button class="cat" data-filter="new">جدیدترین</button>
    <button class="cat" data-filter="fav">محبوب</button>
    <button class="cat" data-filter="iran">ایرانی</button>
</div>

<section class="hero">
    <h2>🎧 موسیقی خوب، حال خوب</h2>
    <p>آهنگ‌های مورد علاقه‌ات را پیدا کن</p>
</section>

<h2 class="section-title">آهنگ‌های من</h2>

<div id="songs">
    <div class="no-songs">در حال بارگذاری آهنگ‌ها...</div>
</div>

<div class="player">
    <div class="player-top">

        <div class="now-cover">🎵</div>

        <div class="now-info">
            <div class="now-name" id="nowName">هنوز آهنگی انتخاب نشده</div>
        </div>

        <div class="controls">
            <button class="ctrl secondary" onclick="previousSong()">⏮</button>
            <button class="ctrl main" id="mainPlay" onclick="togglePlay()">▶</button>
            <button class="ctrl secondary" onclick="nextSong()">⏭</button>
        </div>

    </div>

    <input class="progress" id="progress" type="range" min="0" max="100" value="0">

    <div class="time">
        <span id="currentTime">0:00</span>
        <span id="duration">0:00</span>
    </div>
</div>

<audio id="audio" preload="metadata"></audio>

<script>
let songs = [];
let filtered = [];
let current = -1;
let filter = "all";

const audio = document.getElementById("audio");
const search = document.getElementById("search");
const list = document.getElementById("songs");
const progress = document.getElementById("progress");
const mainPlay = document.getElementById("mainPlay");
const nowName = document.getElementById("nowName");

function esc(s){
    return s.replace(/[&<>"']/g, function(c){
        return {
            "&":"&amp;",
            "<":"&lt;",
            ">":"&gt;",
            '"':"&quot;",
            "'":"&#039;"
        }[c];
    });
}

function formatTime(sec){
    if(!isFinite(sec)) return "0:00";
    sec = Math.floor(sec);
    let m = Math.floor(sec / 60);
    let s = String(sec % 60).padStart(2,"0");
    return m + ":" + s;
}

async function loadSongs(){
    try{
        const res = await fetch("/api/songs?x=" + Date.now());
        songs = await res.json();
        applyFilter();
    }catch(e){
        list.innerHTML = '<div class="empty">خطا در دریافت آهنگ‌ها</div>';
    }
}

function applyFilter(){
    let q = search.value.trim().toLowerCase();

    filtered = songs.filter(song=>{
        let matchesSearch =
            !q ||
            song.name.toLowerCase().includes(q);

        if(filter === "fav"){
            let favs = JSON.parse(localStorage.getItem("nava_favs") || "[]");
            return matchesSearch && favs.includes(song.name);
        }

        return matchesSearch;
    });

    renderSongs();
}

function renderSongs(){
    if(!filtered.length){
        list.innerHTML =
            '<div class="empty">آهنگی پیدا نشد 🎵</div>';
        return;
    }

    list.innerHTML = filtered.map((song,i)=>{
        let favs = JSON.parse(localStorage.getItem("nava_favs") || "[]");
        let isFav = favs.includes(song.name);

        return `
        <div class="song">
            <button class="play" onclick="playSong(${i})">▶</button>

            <div class="cover">🎵</div>

            <div class="songinfo" onclick="playSong(${i})">
                <div class="songname">${esc(song.name)}</div>
                <div class="songtype">موزیک</div>
            </div>

            <button class="fav ${isFav ? "on":""}"
                    onclick="toggleFav(${i})">
                ${isFav ? "♥":"♡"}
            </button>
        </div>`;
    }).join("");
}

function playSong(i){
    if(!filtered[i]) return;

    current = i;

    audio.src = filtered[i].url;
    nowName.textContent = filtered[i].name;

    audio.play().then(()=>{
        mainPlay.textContent = "⏸";
    }).catch(()=>{
        mainPlay.textContent = "▶";
    });
}

function togglePlay(){
    if(!audio.src){
        if(filtered.length) playSong(0);
        return;
    }

    if(audio.paused){
        audio.play();
        mainPlay.textContent = "⏸";
    }else{
        audio.pause();
        mainPlay.textContent = "▶";
    }
}

function nextSong(){
    if(!filtered.length) return;
    current = (current + 1) % filtered.length;
    playSong(current);
}

function previousSong(){
    if(!filtered.length) return;
    current = current <= 0 ? filtered.length - 1 : current - 1;
    playSong(current);
}

function toggleFav(i){
    let name = filtered[i].name;
    let favs = JSON.parse(localStorage.getItem("nava_favs") || "[]");

    if(favs.includes(name)){
        favs = favs.filter(x=>x !== name);
    }else{
        favs.push(name);
    }

    localStorage.setItem("nava_favs", JSON.stringify(favs));
    applyFilter();
}

search.addEventListener("input", applyFilter);

document.querySelectorAll(".cat").forEach(btn=>{
    btn.addEventListener("click",()=>{
        document.querySelectorAll(".cat").forEach(x=>x.classList.remove("active"));
        btn.classList.add("active");
        filter = btn.dataset.filter;
        applyFilter();
    });
});

audio.addEventListener("timeupdate",()=>{
    if(audio.duration){
        progress.value = (audio.currentTime / audio.duration) * 100;
    }

    document.getElementById("currentTime").textContent =
        formatTime(audio.currentTime);
});

audio.addEventListener("loadedmetadata",()=>{
    document.getElementById("duration").textContent =
        formatTime(audio.duration);
});

audio.addEventListener("play",()=>{
    mainPlay.textContent = "⏸";
});

audio.addEventListener("pause",()=>{
    mainPlay.textContent = "▶";
});

audio.addEventListener("ended",nextSong);

progress.addEventListener("input",()=>{
    if(audio.duration){
        audio.currentTime =
            (progress.value / 100) * audio.duration;
    }
});

loadSongs();
</script>

</body>
</html>
'''


class Handler(BaseHTTPRequestHandler):

    def send_bytes(self, data, content_type):
        self.send_response(200)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        path = unquote(self.path.split("?", 1)[0])

        # صفحه اصلی
        if path == "/" or path == "/index.html":
            self.send_bytes(
                HTML.encode("utf-8"),
                "text/html; charset=utf-8"
            )
            return

        # لیست آهنگ‌ها
        if path == "/api/songs":
            songs = []

            try:
                files = os.listdir(BASE)
            except Exception:
                files = []

            for name in files:
                full = os.path.join(BASE, name)

                if (
                    os.path.isfile(full)
                    and name.lower().endswith(".mp3")
                    and not name.startswith(".")
                ):
                    songs.append({
                        "name": os.path.splitext(name)[0],
                        "url": "/music/" + quote(name)
                    })

            songs.sort(
                key=lambda x: os.path.getmtime(
                    os.path.join(BASE, x["name"] + ".mp3")
                ) if os.path.exists(
                    os.path.join(BASE, x["name"] + ".mp3")
                ) else 0,
                reverse=True
            )

            data = json.dumps(
                songs,
                ensure_ascii=False
            ).encode("utf-8")

            self.send_bytes(
                data,
                "application/json; charset=utf-8"
            )
            return

        # فایل موسیقی
        if path.startswith("/music/"):
            filename = unquote(path[len("/music/"):])
            filename = os.path.basename(filename)

            # فقط MP3
            if not filename.lower().endswith(".mp3"):
                self.send_error(403)
                return

            filepath = os.path.join(BASE, filename)

            if not os.path.isfile(filepath):
                self.send_error(404)
                return

            try:
                size = os.path.getsize(filepath)

                self.send_response(200)
                self.send_header("Content-Type", "audio/mpeg")
                self.send_header("Content-Length", str(size))
                self.send_header("Accept-Ranges", "bytes")
                self.send_header("Cache-Control", "no-cache")
                self.end_headers()

                with open(filepath, "rb") as f:
                    while True:
                        chunk = f.read(64 * 1024)

                        if not chunk:
                            break

                        try:
                            self.wfile.write(chunk)
                        except (BrokenPipeError, ConnectionResetError):
                            break

            except Exception as e:
                print("Music error:", e)

            return

        self.send_error(404)

    def log_message(self, fmt, *args):
        print("%s - %s" % (
            self.address_string(),
            fmt % args
        ))


def main():
    os.makedirs(BASE, exist_ok=True)

    print("")
    print("================================")
    print("        NAVA MUSIC SERVER")
    print("================================")
    print("Music folder:", BASE)
    print("Website: http://127.0.0.1:8080")
    print("================================")
    print("")

    server = ThreadingHTTPServer(
        ("127.0.0.1", PORT),
        Handler
    )

    try:
        server.serve_forever()

    except KeyboardInterrupt:
        print("\nServer stopped.")

    finally:
        server.server_close()


if __name__ == "__main__":
    main()
